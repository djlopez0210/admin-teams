# ==========================================
# CONFIGURACIÓN DEL BACKEND & SERVICIOS
# ==========================================

# Base de Datos (MySQL)
DATABASE_URL=mysql+pymysql://team_user:team_password@localhost:3307/football_team?charset=utf8mb4
SECRET_KEY=super_secret_production_key_123

# Nombre de la plataforma y URL de acceso
PLATFORM_NAME=Gestión Deportiva
APP_URL=http://localhost:3000

# ==========================================
# CONFIGURACIÓN DE CORREO SALIENTE (SMTP)
# ==========================================
# Si dejas SMTP_HOST en blanco, el sistema simula el envío
# y muestra el correo formateado en los logs de la consola del servidor.

# Ejemplo con Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_password_de_aplicacion_gmail  # Generada en tu cuenta de Google > Seguridad > Contraseñas de app
# SMTP_USE_TLS=true
# SMTP_FROM_EMAIL=tu_correo@gmail.com
# SMTP_FROM_NAME=Gestión Deportiva

# Ejemplo con Outlook / Office 365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@outlook.com
# SMTP_PASS=tu_password
# SMTP_USE_TLS=true

# Ejemplo con servidor SMTP propio / cPanel / Mailgun / SendGrid:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Plataforma Deportiva
